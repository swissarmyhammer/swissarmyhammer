//! The pass fixture for `no-commented-code-parsed`.
//!
//! It holds the three shapes the rule must leave alone, and each one is the
//! same commented-out function the fail fixture carries, exempted a different
//! way. A rule that stopped reading one of the three still passes the pair
//! unless all three are here.

/// Folds a grid of readings into one band.
///
/// The doc comment carries the example, which is the exemption the rule states:
/// intentional example code lives in documentation.
///
/// ```
/// fn folded_band(grid: &[Vec<i32>], limit: i32) -> i32 {
///     let mut band = 0;
///     for row in grid {
///         band += row.iter().filter(|cell| **cell < limit).count() as i32;
///     }
///     band
/// }
/// ```
pub fn documented_band(limit: i32) -> i32 {
    limit
}

