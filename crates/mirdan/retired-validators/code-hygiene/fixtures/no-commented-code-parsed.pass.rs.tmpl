// limit, because the limit is what decides how many rows a fold may touch.
// See the design note beside this module for the order the rows must take.
// Until then this comment is a note to a reader and nothing more.
pub fn noted_band(limit: i32) -> i32 {
    limit
}

// let band = 0;
