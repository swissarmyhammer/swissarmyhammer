// The passing fixture of the `complexity-swift` tool rule.
//
// It holds one function for each gate the rule decides.
//
// - `classifyReading` holds the same shape at 4 decision points, with the
//   band chain moved to `bandStep`.
// - `mixState` holds the same shape at 202 counted lines.
//
// The tool must report nothing. A threshold that stopped applying would
// report one of the two, and the pair would fail.

/// The wrap the mixing steps below fold each state through.
let modulus: UInt64 = 4294967296

/// Returns the band one reading adds, read off a table rather than a chain.
///
/// - Parameters:
///   - sample: The reading to fold.
///   - limit: The reading the middle band stops at.
/// - Returns: The band step this reading adds.
func bandStep(sample: Int, limit: Int) -> Int {
    if sample < 0 {
        return -1
    }
    let step = sample / max(limit, 1)
    return min(step + 1, 11)
}

/// Classifies a run of readings into one band, with the chain in a table.
///
/// The same shape as the failing fixture, holding 4 decision points against
/// the gate of 15 once the band chain moves to `bandStep`.
///
/// - Parameters:
///   - samples: The readings to fold.
///   - mode: How strict the fold is.
///   - limit: The reading the middle band stops at.
/// - Returns: The folded band.
public func classifyReading(samples: [Int], mode: String, limit: Int) -> Int {
    var band = 0
    for sample in samples {
        band += bandStep(sample: sample, limit: limit)
        while band > limit {
            band -= limit
        }
        if mode == "strict" {
            band += 1
        }
        if band < 0 {
            band = 0
        }
    }
    return band
}

/// Folds a seed into a state, one unrolled mixing step for each round.
