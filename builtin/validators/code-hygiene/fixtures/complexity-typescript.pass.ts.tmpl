// The passing fixture of the `complexity-typescript` tool rule.
//
// It holds one function for each gate the rule decides.
//
// - `foldGrid` holds the same shape at score 3, with the per-reading test
//   moved to `stepBand`.
// - `mixState` holds the same shape at 204 counted lines.
//
// The tool must report nothing. A threshold that stopped applying would
// report one of the two, and the pair would fail.

/** The wrap the mixing steps below fold each state through. */
const MODULUS = 4294967296;

/**
 * Returns the band one reading adds, with the nesting held to one level.
 *
 * @param cell - The reading to fold.
 * @param limit - The reading the middle band stops at.
 * @param band - The band so far.
 * @returns The band after this reading.
 */
function stepBand(cell: number, limit: number, band: number): number {
  if (cell <= 0) {
    return band;
  }
  if (cell >= limit) {
    return band;
  }
  let stepped = band;
  while (stepped < cell) {
    stepped += stepped % 2 === 0 ? 3 : 1;
  }
  return stepped;
}

/**
 * Folds a grid of readings into one band, with the per-reading test in a helper.
 *
 * The same shape as the failing fixture, scored 3 against the gate of 15 once
 * the four inner blocks move to `stepBand`.
 *
 * @param grid - Rows of readings to fold.
 * @param limit - The reading the middle band stops at.
 * @returns The folded band.
 */
export function foldGrid(grid: number[][], limit: number): number {
  let band = 0;
  for (const row of grid) {
    for (const cell of row) {
      band = stepBand(cell, limit, band);
    }
  }
  return band;
}

/**
