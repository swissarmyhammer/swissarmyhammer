"""The passing fixture of the `complexity-python` tool rule.

It holds the same shape under the gate: `classify_reading` scores 10 against
the gate of 15 once the sample bands move to a helper and three flag steps move
to a table. The tool must report nothing. A threshold that stopped applying
would report the function, and the pair would fail.
"""

FLAG_STEPS = {"trim": -1, "shift": 100, "half": 0}


def _sample_step(sample, limit):
    """Return the band step one sample adds."""
    if sample < 0:
        return -1
    if sample < limit:
        return 1
    if sample < limit * 2:
        return 2
    return 3


def classify_reading(samples, mode, limit, flags):
    """Fold a run of samples into a band, with the sample bands in a helper."""
    band = 0
    for sample in samples:
        band += _sample_step(sample, limit)
        while band > 10:
            band -= 5
        if mode == "strict" and sample > limit:
            band += 1
    for flag in flags:
        band += FLAG_STEPS.get(flag, 0)
    if "clamp" in flags:
        band = min(band, 9)
    if "floor" in flags:
        band = max(band, 0)
    if "invert" in flags:
        band = -band
    if mode == "loose":
        band += 1
    try:
        return int(band)
    except (TypeError, ValueError):
        return 0
