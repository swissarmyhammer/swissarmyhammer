"""The failing fixture of the `magic-numbers-python` tool rule.

This file holds one unnamed literal in every comparison kind the passing fixture
names — equality, ordering, and a chained comparison. It also holds `100`, which
the `magic-numbers` prompt rule carves out and this tool reports. The tool must
report each one. A tool upgrade that stops reporting a kind, or that starts to
allow `100`, makes the doctor mark the rule unusable.
"""


def equality(status: int) -> bool:
    """Compare for equality against an unnamed literal."""
    return status == 404


def ordering(size: int) -> bool:
    """Compare for order against an unnamed literal."""
    return size > 4096


def chained(ratio: int) -> bool:
    """Compare against an unnamed literal on each side of a chain."""
    return 10 <= ratio <= 90


def conventional(ratio: int) -> bool:
    """Compare against 100, the prompt carve-out `ruff` cannot express."""
    return ratio == 100
