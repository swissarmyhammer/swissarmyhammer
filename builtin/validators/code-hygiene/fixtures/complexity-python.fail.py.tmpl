"""The failing fixture of the `complexity-python` tool rule.

It holds one function over the cyclomatic complexity gate: `classify_reading`
scores 17 against the gate of 15. The tool must report it. A tool upgrade that
stops reporting the shape makes the doctor mark the rule unusable.
"""


def classify_reading(samples, mode, limit, flags):
    """Fold a run of samples into a band, one branch for each condition.

    Every flag reads its own ``if``, and the sample loop nests a chain inside a
    loop, so the branches add up past the complexity gate.
    """
    band = 0
    for sample in samples:
        if sample < 0:
            band -= 1
        elif sample < limit:
            band += 1
        elif sample < limit * 2:
            band += 2
        else:
            band += 3
        while band > 10:
            band -= 5
        if mode == "strict" and sample > limit:
            band += 1
    if "trim" in flags:
        band -= 1
    if "clamp" in flags:
        band = min(band, 9)
    if "floor" in flags:
        band = max(band, 0)
    if "double" in flags:
        band *= 2
    if "invert" in flags:
        band = -band
    if "half" in flags:
        band //= 2
    if "shift" in flags:
        band += 100
    if "cap" in flags:
        band = min(band, 50)
    if mode == "loose":
        band += 1
    try:
        return int(band)
    except (TypeError, ValueError):
        return 0
