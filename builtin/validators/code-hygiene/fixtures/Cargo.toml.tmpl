# The Rust fixtures of the `missing-docs-rust` and `function-length-rust` tool
# rules, as a package.
#
# `cargo clippy` needs a package to lint, so every Rust fixture file is a
# module of this one. `[workspace]` stops cargo from joining the repository
# workspace above this directory, so the tool sees the fixtures and nothing
# else.
[package]
name = "code-hygiene-fixtures"
version = "0.0.0"
edition = "2021"
publish = false

[lib]
path = "lib.rs"

[workspace]
