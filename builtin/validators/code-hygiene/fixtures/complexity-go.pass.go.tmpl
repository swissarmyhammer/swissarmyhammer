// Package fixtures holds the Go fixtures of the `complexity-go` tool rule.
//
// This file holds the same shape under the gate: SimpleFoldGrid scores 3
// against the gate of 15 once the per-reading test moves to simpleBandStep.
//
// The tool must report nothing. A threshold that stopped applying would report
// the function, and the pair would fail.
package fixtures

// simpleBandStep returns the band one reading adds.
func simpleBandStep(cell, limit, band int) int {
	if cell <= 0 || cell >= limit {
		return band
	}
	stepped := band
	for stepped < cell {
		stepped += 3
	}
	return stepped
}

// SimpleFoldGrid folds a grid of readings into one band, with the per-reading
// test in a helper.
func SimpleFoldGrid(grid [][]int, limit int) int {
	band := 0
	for _, row := range grid {
		for _, cell := range row {
			band = simpleBandStep(cell, limit, band)
		}
	}
	return band
}
