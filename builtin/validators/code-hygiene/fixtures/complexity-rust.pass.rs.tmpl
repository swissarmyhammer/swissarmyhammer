//! The passing fixture of the `complexity-rust` tool rule.
//!
//! It holds the same two shapes under the gates. Both are free functions in a
//! module file, so each carries one level of item overhead: the function body
//! is level 1.
//!
//! - `fold_grid` nests five control-flow blocks, so its innermost block sits at
//!   nesting level 6 against the gate of 6 — at the gate, not over it.
//! - `mix_state` runs 202 code lines against the line gate of 250.
//!
//! The tool must report nothing. A threshold that stopped applying would report
//! both, and the pair would fail.

/// Folds a grid of readings into one band, with the two range tests joined.
///
/// The shape under measurement is a free function at control-flow depth 5:
/// `for`, `for`, `if`, `while`, `if`. A free function body is level 1, so the
/// innermost `if` block sits at nesting level 6, which is the gate itself.
pub fn fold_grid(grid: &[Vec<i32>], limit: i32) -> i32 {
    let mut band = 0;
    for row in grid {
        for cell in row {
            if *cell > 0 && *cell < limit {
                while band < *cell {
                    if band % 2 == 0 {
                        band += 2;
                    }
                    band += 1;
                }
            }
        }
    }
    band
}

