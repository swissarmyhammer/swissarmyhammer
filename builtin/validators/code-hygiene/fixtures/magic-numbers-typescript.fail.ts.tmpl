/**
 * The failing fixture of the `magic-numbers-typescript` tool rule.
 *
 * This file holds one unnamed literal in every position the passing fixture
 * names — a comparison, an operation, and a call argument — and the shift
 * operand the rule cannot carve out. The tool must report each one. A tool
 * upgrade that stops reporting a position makes the doctor mark the rule
 * unusable.
 */

/** Take a delay so the call-argument position below has a callee. */
export function schedule(delayMillis: number): number {
  return delayMillis;
}

/** Compare against an unnamed literal. */
export function comparison(status: number): boolean {
  return status === 404;
}

/** Multiply by an unnamed literal. */
export function operation(size: number): number {
  return size * 4096;
}

/** Pass an unnamed literal as a call argument. */
export function argument(): number {
  return schedule(250);
}

/**
 * Shift by an unnamed literal. The `magic-numbers` prompt rule carves this
 * form out, and the rule cannot: `ignore` selects a value and never a
 * position, so the shift operand reports.
 */
export function shift(word: number): number {
  return word << 8;
}
