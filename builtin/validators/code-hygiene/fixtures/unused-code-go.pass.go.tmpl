// Package fixtures holds the Go fixtures of the `unused-code-go` tool rule.
//
// This file holds the same six dead shapes the failing fixture holds — the
// type, the struct field, the method, the constant, the variable, and the
// function — each carrying the `//lint:ignore U1000 <reason>` staging marker.
// The tool must report nothing. A tool upgrade that reports one anyway makes
// the doctor mark the rule unusable.
package fixtures

//lint:ignore U1000 the first user lands in the next change
type stagedType struct{}

// stagedHolder is named by the exported root below, so the marker on its
// staged field is the only thing keeping the field out of the report.
type stagedHolder struct {
	liveField int
	//lint:ignore U1000 the reader lands in the next change
	stagedField int
}

//lint:ignore U1000 the caller lands in the next change
func (h stagedHolder) stagedMethod() int { return h.liveField }

//lint:ignore U1000 the reader lands in the next change
const stagedConst = 1

//lint:ignore U1000 the reader lands in the next change
var stagedVar = 2

//lint:ignore U1000 the caller lands in the next change
func stagedFunc() int { return 3 }

// DeadCodePassRoot keeps stagedHolder and its live field in use. Without it the
// tool would report the type around the staged field, and the fixture would no
// longer pin the struct-field kind on its own.
func DeadCodePassRoot() int {
	return stagedHolder{liveField: 1}.liveField
}
