//! The failing fixture of the `complexity-rust` tool rule.
//!
//! It holds one function over each gate the rule can exercise in a fixture.
//! Both shapes are free functions in a module file, so each carries one level
//! of item overhead: the function body is level 1.
//!
//! - `fold_grid` nests six control-flow blocks, so its innermost block sits at
//!   nesting level 7 against the gate of 6.
//! - `mix_state` runs 262 code lines against the line gate of 250.
//!
//! The tool must report both. A tool upgrade that stops reporting one of the
//! two makes the doctor mark the rule unusable.

/// Folds a grid of readings into one band, one nested block for each test.
///
/// The shape under measurement is a free function at control-flow depth 6:
/// `for`, `for`, `if`, `if`, `while`, `if`. A free function body is level 1,
/// so the innermost `if` block sits at nesting level 7, one over the gate.
pub fn fold_grid(grid: &[Vec<i32>], limit: i32) -> i32 {
    let mut band = 0;
    for row in grid {
        for cell in row {
            if *cell > 0 {
                if *cell < limit {
                    while band < *cell {
                        if band % 2 == 0 {
                            band += 2;
                        }
                        band += 1;
                    }
                }
            }
        }
    }
    band
}

